{
  "name": "nsa-presence-server",
  "version": "0.2.0",
  "description": "Shares the Nintendo Switch presence of the friends of a shared Nintendo account with their agents",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/DamienFoulon/NSA.git",
    "directory": "server"
  },
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "tsc -p .",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "start:mock": "MOCK=1 node --env-file-if-exists=.env dist/src/index.js",
    "login": "node dist/scripts/login.js",
    "test": "npm run build && node --test \"dist/test/*.test.js\""
  },
  "dependencies": {
    "nxapi": "1.6.1-next.257"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
