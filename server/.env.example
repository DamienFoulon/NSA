# --- Secret shared with the agent (generate with: openssl rand -hex 32) ---
PRESENCE_TOKEN=

# --- Nintendo (not needed when MOCK=1) ---
# Session token of the SECONDARY Nintendo account (npm run login)
NSO_SESSION_TOKEN=
# NSA ID of your MAIN account, as seen in the secondary account's friend list (npm run list-friends)
NSO_FRIEND_NSA_ID=
# nxapi-auth client registered at https://nxapi-auth.fancy.org.uk/oauth/clients
NXAPI_ZNCA_API_CLIENT_ID=
# Only for a confidential client
#NXAPI_ZNCA_API_CLIENT_SECRET=

# Poll interval in seconds (minimum 30)
POLL_INTERVAL_SECONDS=45

# Set to 1 to serve a fake presence instead of polling Nintendo
#MOCK=1

# Provided by Alwaysdata on the server; only useful locally
#IP=127.0.0.1
#PORT=8080
