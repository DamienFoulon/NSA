# --- Shared Nintendo account ---
# Session token of the SHARED Nintendo account (npm run login)
NSO_SESSION_TOKEN=
# nxapi-auth client registered at https://nxapi-auth.fancy.org.uk/oauth/clients
NXAPI_ZNCA_API_CLIENT_ID=
# Only for a confidential client
#NXAPI_ZNCA_API_CLIENT_SECRET=

# Poll interval in seconds (minimum 30)
POLL_INTERVAL_SECONDS=45

# --- Users and pairing ---
# Directory of users.json (linked users), relative to the working directory
DATA_DIR=data
# How long a friend request waits for acceptance
PAIRING_TTL_MINUTES=60
# Friend requests sent per day by the shared account (open registration)
MAX_FRIEND_REQUESTS_PER_DAY=30
# Pairing attempts per IP address and per hour
MAX_PAIRINGS_PER_IP_PER_HOUR=5

# Set to 1 to use a fake Nintendo account instead
#MOCK=1

# Provided by Alwaysdata on the server; only useful locally
#IP=127.0.0.1
#PORT=8080
