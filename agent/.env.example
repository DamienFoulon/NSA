# Full URL of the presence endpoint
PRESENCE_URL=https://example.alwaysdata.net/presence
# Same secret as PRESENCE_TOKEN on the server
PRESENCE_TOKEN=
# Application ID from https://discord.com/developers/applications
DISCORD_CLIENT_ID=
# Poll interval in seconds (15 to 30 recommended)
POLL_INTERVAL_SECONDS=20
# Art asset uploaded in the Discord app, used when the game has no image
#DISCORD_FALLBACK_IMAGE=switch
