# systemd user service for the NSA presence agent.
# Install: see the "Agent" section of the README.
[Unit]
Description=NSA - Nintendo Switch presence to Discord Rich Presence
After=network-online.target

[Service]
Type=simple
# Adjust both paths: the agent directory and the absolute path of node (`command -v node`).
WorkingDirectory=%h/NSA/agent
ExecStart=/usr/bin/node --env-file-if-exists=.env dist/src/index.js
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
